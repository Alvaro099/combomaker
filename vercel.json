{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "combomaker/static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/Street Fighter 6 Notation PNGs/(.*)",
      "dest": "/combomaker/static/Street Fighter 6 Notation PNGs/$1"
    },
    {
      "src": "/static/Street Fighter 6 Notation PNGs/buttons(.*)",
      "dest": "/combomaker/static/Street Fighter 6 Notation PNGs/buttons/$1"
    },
    {
      "src": "/static/Street Fighter 6 Notation PNGs/movement(.*)",
      "dest": "/combomaker/static/Street Fighter 6 Notation PNGs/movement/$1"
    },
    {
      "src": "/static/Street Fighter 6 Notation PNGs/special(.*)",
      "dest": "/combomaker/static/Street Fighter 6 Notation PNGs/special/$1"
    },
    {
      "src": "/static/Tekken Notation PNGs/buttons(.*)",
      "dest": "/combomaker/static/Tekken Notation PNGs/buttons/$1"
    },
    {
      "src": "/static/Tekken Notation PNGs/movement(.*)",
      "dest": "/combomaker/static/Tekken Notation PNGs/movement/$1"
    },
    {
      "src": "/static/Tekken Notation PNGs/special(.*)",
      "dest": "/combomaker/static/Tekken Notation PNGs/special/$1"
    },
    {
      "src": "/static/TWOXKO Notation PNGs/buttons(.*)",
      "dest": "/combomaker/static/TWOXKO Notation PNGs/buttons/$1"
    },
    {
      "src": "/static/TWOXKO Notation PNGs/movement(.*)",
      "dest": "/combomaker/static/TWOXKO Notation PNGs/movement/$1"
    },
    {
      "src": "/static/TWOXKO Notation PNGs/special(.*)",
      "dest": "/combomaker/static/TWOXKO Notation PNGs/special/$1"
    },
    {
      "src": "/static/(.*)",
      "dest": "/combomaker/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}