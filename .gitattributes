# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Force LF for common text file types
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files: disable EOL conversion and other text processing
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.mov binary
*.mp4 binary
*.zip binary
*.tar.gz binary

# Ensure files with uppercase extensions are treated as binary too
*.PNG binary
